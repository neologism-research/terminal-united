{
  "name": "terminal-united",
  "version": "0.1.0",
  "private": true,
  "description": "Casual social MMORPG for the terminal.",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @tu/server dev",
    "dev:client": "pnpm --filter @tu/client dev",
    "db:push": "pnpm --filter @tu/server db:push",
    "docs:dev": "pnpm --filter @tu/docs dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.0.8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
